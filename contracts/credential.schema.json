{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "合规结论互认凭证",
  "type": "object",
  "required": [
    "credential_id",
    "issuer",
    "audience",
    "subject_ref",
    "order_ref",
    "order_digest",
    "scopes",
    "rule_set_version",
    "list_epoch",
    "evidence_digest",
    "not_before",
    "not_after",
    "restrictions",
    "idempotency_key",
    "issuer_head",
    "signature"
  ],
  "properties": {
    "credential_id": {
      "type": "string",
      "pattern": "^cred_[0-9a-f]{24}$"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^ps_[0-9a-f]{24}$"
    },
    "order_ref": {
      "type": "string",
      "minLength": 1
    },
    "order_digest": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "aml",
          "trade_background",
          "cross_border"
        ]
      }
    },
    "rule_set_version": {
      "type": "string",
      "minLength": 1
    },
    "list_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "evidence_digest": {
      "type": "string",
      "minLength": 1
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "not_after": {
      "type": "string",
      "format": "date-time"
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+(<=|>=|=).+$"
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "issuer_head": {
      "type": "integer",
      "minimum": 1
    },
    "signature": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
