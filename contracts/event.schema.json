{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "互认事件",
  "type": "object",
  "required": [
    "seq",
    "type",
    "at",
    "payload"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "CREDENTIAL_ISSUED",
        "CREDENTIAL_REVOKED",
        "ORDER_SUPERSEDED",
        "LIST_UPDATED",
        "CHALLENGE_OPENED",
        "CHALLENGE_RESOLVED",
        "RELATIONSHIP_PAUSED",
        "RELATIONSHIP_RESUMED"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
